{
  "title": "TideGuard API",
  "uid": "tideguard-api",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["tideguard", "fastapi", "marine-debris"],
  "templating": {
    "list": [
      {
        "name": "source",
        "type": "query",
        "query": "label_values(tideguard_forecast_latency_seconds_bucket, source)",
        "datasource": "Prometheus",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Forecast latency P50/P95/P99 (s)",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tideguard_forecast_latency_seconds_bucket{source=~\"$source\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tideguard_forecast_latency_seconds_bucket{source=~\"$source\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tideguard_forecast_latency_seconds_bucket{source=~\"$source\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Forecast req/s by source",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(tideguard_forecast_latency_seconds_count[$__rate_interval]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model loaded",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "max(tideguard_model_loaded)" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "MOCK" }, "1": { "text": "REAL" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Citizen reports per minute",
      "datasource": "Prometheus",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 8 },
      "targets": [
        {
          "expr": "sum by (result) (rate(tideguard_report_uploads_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exceedance latency P95",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tideguard_exceedance_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Report rejection ratio",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(tideguard_report_uploads_total{result=\"rejected\"}[$__rate_interval])) / clamp_min(sum(rate(tideguard_report_uploads_total[$__rate_interval])), 1e-9)",
          "legendFormat": "reject ratio"
        }
      ]
    }
  ]
}
