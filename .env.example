DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/tideguard
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DATA=tideguard-data
S3_BUCKET_PHOTOS=tideguard-photos
COPERNICUS_MARINE_USER=
COPERNICUS_MARINE_PASSWORD=
CDS_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
MAPTILER_KEY=
WANDB_API_KEY=
SENTRY_DSN=

# ML — set PINN_ENSEMBLE_DIR to the directory containing the trained
# PINN ensemble (.pt files).  When set, /forecast/exceedance will use the
# real ensemble; otherwise it falls back to a perturbed-initial-condition
# (PIC) mock and the model_version is tagged "pic-fallback-v0.2".
PINN_CHECKPOINT_PATH=checkpoints/black_sea_v0.3.0/pinn_black_sea_seed0.pt
PINN_ENSEMBLE_DIR=checkpoints/black_sea_v0.3.0

# Authentication / OIDC
JWT_SECRET=
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://api.tideguard.app/auth/oidc/callback

# Observability
PROMETHEUS_RULES_ENABLED=true
OTLP_ENDPOINT=


# --- v0.5 monetization stack ----------------------------------------------

# Billing provider switch: stripe | paddle | manual
BILLING_PROVIDER=stripe
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_PUBLIC_KEY=

# Email provider: resend | postmark | ses | console
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=TideGuard <noreply@tideguard.app>
MAGIC_LINK_TTL_SECONDS=900

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=

# Routing
OSRM_BASE_URL=https://routing.openstreetmap.de
OR_TOOLS_SOLVER_TIME_LIMIT_MS=10000

# API-key enforcement (defaults to soft — set true to block on quota exceed)
API_KEY_ENFORCEMENT=false
API_KEY_REDIS_NAMESPACE=tg:usage

# ESG
ESG_RISK_GRID_CELL_DEG=0.05
ESG_METHODOLOGY_VERSION=esg-v1.0

# Adopt-a-Beach
ADOPT_SEGMENT_DEFAULT_LENGTH_M=1000
ADOPT_MAX_ACTIVE_PER_USER=5

# --- v0.5.1 demo deployment helpers ---------------------------------------

# Run the idempotent seeders (regions, beach segments, education tiers)
# inside the FastAPI lifespan hook on first startup. Recommended for fresh
# Fly.io / Render deployments so /adopt-a-beach is not empty out-of-the-box.
AUTO_SEED_ON_STARTUP=true

# Extra CORS origins (comma-separated, full URLs, no trailing slash).
# Whitelists the exact URL Vercel/Netlify handed your frontend deploy
# without recompiling the API. Example:
#   EXTRA_CORS_ORIGINS=https://mnohyjmg.vercel.app,https://my-app.netlify.app
EXTRA_CORS_ORIGINS=

# Override the permissive default regex if you need stricter CORS:
#   CORS_ORIGIN_REGEX=^https://(www\.)?tideguard\.app$
CORS_ORIGIN_REGEX=
