# Copy to `.env.local` (gitignored) before running `pnpm dev` or `pnpm build`.

# Backend API base URL. For local recording, leave as localhost. For Vercel
# deploy, set to your deployed Fly.io / Render URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# When "1" (default), the Adopt-a-Beach button shows a friendly demo notice
# instead of starting a Stripe checkout, and the B2G "Download PDF" button
# uses a clean blob-download path. Set to "0" once you wire up real Stripe.
NEXT_PUBLIC_DEMO_MODE=1

# Repo URL shown on the landing page / juror walkthrough. Optional override
# if you fork the repo to a different name.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/BitMagistrate/TideGuard
